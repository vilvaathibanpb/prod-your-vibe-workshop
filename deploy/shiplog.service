# /etc/systemd/system/shiplog.service — keeps the backend running (Lab 2, + EnvironmentFile in Lab 3)
[Unit]
Description=Ship Log
After=network.target

[Service]
User=deploy
WorkingDirectory=/home/deploy/shiplog/backend
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=2
Environment=NODE_ENV=production
EnvironmentFile=/etc/shiplog.env

[Install]
WantedBy=multi-user.target
